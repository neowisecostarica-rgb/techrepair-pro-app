{
  "name": "AuditEvent",
  "type": "object",
  "properties": {
    "event_type": { "type": "string" },
    "principal_class": {
      "type": "string",
      "enum": ["HUMAN_MEMBER", "CUSTOMER_TOKEN", "SYSTEM_AUTOMATION", "PLATFORM_ADMIN"]
    },
    "actor_user_id": { "type": "string" },
    "actor_primary_role": { "type": "string" },
    "effective_technician_user_id": { "type": "string" },
    "organization_id": { "type": "string" },
    "branch_id": { "type": "string" },
    "resource_type": { "type": "string" },
    "resource_id": { "type": "string" },
    "command_policy_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "external_correlation_id": { "type": "string" },
    "audit_operation_id": { "type": "string" },
    "operation_key": { "type": "string" },
    "operation_semantics": { "type": "object" },
    "outcome": {
      "type": "string",
      "enum": ["COMMITTED", "DUPLICATE", "DENIED", "FAILED", "RECONCILED"]
    },
    "prior_state": { "type": "object" },
    "new_state": { "type": "object" },
    "custody_snapshot": { "type": "object" },
    "metadata": { "type": "object" },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "required": [
    "event_type",
    "principal_class",
    "organization_id",
    "resource_type",
    "resource_id",
    "command_policy_id",
    "correlation_id",
    "audit_operation_id",
    "outcome",
    "occurred_at"
  ],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}

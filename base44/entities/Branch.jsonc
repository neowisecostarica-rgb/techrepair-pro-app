{
  "name": "Branch",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n"
    },
    "name": {
      "type": "string",
      "description": "Nombre de la sucursal"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n f\u00edsica (opcional)"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto (opcional)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Estado de la sucursal"
    },
    "sale_lock_token": {
      "type": "string",
      "description": "Mutex persistido para ventas directas de la sucursal.",
      "rls": { "read": false, "write": false }
    },
    "sale_lock_operation_key": {
      "type": "string",
      "rls": { "read": false, "write": false }
    },
    "sale_lock_at": {
      "type": "string",
      "format": "date-time",
      "rls": { "read": false, "write": false }
    }
  },
  "required": [
    "organization_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": { "role": "admin" }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": { "role": "admin" }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": { "role": "admin" }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": { "role": "admin" }
        }
      ]
    }
  }
}

{
  "name": "Cliente",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n (tenant)"
    },
    "branch_id": {
      "type": "string",
      "description": "Sucursal de alta; acceso legacy tambien puede derivarse de OT o Venta"
    },
    "nombre_completo": {
      "type": "string",
      "description": "Nombre completo del cliente"
    },
    "identificacion": {
      "type": "string",
      "description": "C\u00e9dula, pasaporte o ID fiscal (identidad \u00fanica)"
    },
    "tipo_cliente": {
      "type": "string",
      "enum": [
        "individual",
        "empresa"
      ],
      "default": "individual",
      "description": "Tipo de cliente"
    },
    "telefono": {
      "type": "string",
      "description": "N\u00famero de tel\u00e9fono principal"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Correo electr\u00f3nico (opcional)"
    },
    "direccion": {
      "type": "string",
      "description": "Direcci\u00f3n f\u00edsica (opcional)"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales sobre el cliente"
    }
  },
  "required": [
    "organization_id",
    "nombre_completo",
    "identificacion",
    "telefono",
    "tipo_cliente"
  ],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}

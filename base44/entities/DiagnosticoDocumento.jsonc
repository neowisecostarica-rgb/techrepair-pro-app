{
  "name": "DiagnosticoDocumento",
  "type": "object",
  "properties": {
    "diagnostico_id": {
      "type": "string",
      "description": "ID del diagn\u00f3stico t\u00e9cnico asociado"
    },
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n (tenant)"
    },
    "version": {
      "type": "string",
      "description": "Versi\u00f3n del documento (ej: v1, v2)"
    },
    "formato": {
      "type": "string",
      "enum": [
        "pdf"
      ],
      "default": "pdf",
      "description": "Formato del documento"
    },
    "url_documento": {
      "type": "string",
      "description": "URL del documento generado"
    },
    "estado": {
      "type": "string",
      "enum": [
        "EMITIDO",
        "ENVIADO",
        "ANULADO"
      ],
      "default": "EMITIDO",
      "description": "Estado del ciclo de vida documental"
    },
    "emitido_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de emisi\u00f3n del documento"
    },
    "snapshot_data": {
      "type": "object",
      "description": "Snapshot inmutable del diagn\u00f3stico al momento de emisi\u00f3n"
    },
    "aprobacion_status": {
      "type": "string",
      "enum": [
        "PENDIENTE",
        "APROBADA",
        "RECHAZADA",
        "EXPIRADA"
      ],
      "default": "PENDIENTE",
      "description": "Estado de aprobaci\u00f3n del documento (dimensi\u00f3n independiente del estado documental)"
    },
    "aprobacion_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de la aprobaci\u00f3n o rechazo del cliente"
    },
    "aprobacion_canal": {
      "type": "string",
      "description": "Canal por el que se registr\u00f3 la respuesta de aprobaci\u00f3n (legacy)"
    },
    "anulado_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de anulaci\u00f3n del documento"
    },
    "canal_envio": {
      "type": "string",
      "enum": [
        "WHATSAPP",
        "EMAIL",
        "MANUAL"
      ],
      "description": "Canal utilizado para el \u00faltimo env\u00edo del documento al cliente"
    },
    "enviado_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp del \u00faltimo env\u00edo del documento al cliente"
    },
    "enviado_por": {
      "type": "string",
      "description": "ID del usuario que realiz\u00f3 el env\u00edo"
    },
    "metodo_aprobacion": {
      "type": "string",
      "enum": [
        "VERBAL",
        "WHATSAPP_CONFIRM",
        "FIRMA_FISICA",
        "PORTAL_DIGITAL"
      ],
      "description": "M\u00e9todo mediante el cual el cliente otorg\u00f3 su aprobaci\u00f3n (opcional, para auditor\u00eda)"
    }
  },
  "required": [
    "diagnostico_id",
    "organization_id",
    "version",
    "formato",
    "url_documento"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": { "role": "admin" }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": { "role": "admin" }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": { "role": "admin" }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": { "role": "admin" }
        }
      ]
    }
  }
}
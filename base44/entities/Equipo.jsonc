{
  "name": "Equipo",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n (tenant)"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente propietario"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "laptop",
        "desktop",
        "tablet",
        "smartphone",
        "impresora",
        "otro"
      ],
      "description": "Tipo de equipo"
    },
    "marca": {
      "type": "string",
      "description": "Marca del equipo"
    },
    "modelo": {
      "type": "string",
      "description": "Modelo del equipo"
    },
    "serie": {
      "type": "string",
      "description": "N\u00famero de serie o IMEI"
    },
    "estado_fisico": {
      "type": "string",
      "enum": [
        "excelente",
        "bueno",
        "regular",
        "malo"
      ],
      "description": "Estado f\u00edsico al recibir"
    },
    "accesorios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Accesorios incluidos"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de fotos del equipo"
    }
  },
  "required": [
    "cliente_id",
    "tipo",
    "marca"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "organization_id": "{{user.organization_id}}"
        },
        {
          "organization_id": "{{user.impersonating_org_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "organization_id": "{{user.organization_id}}"
        },
        {
          "organization_id": "{{user.impersonating_org_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "organization_id": "{{user.organization_id}}"
        },
        {
          "organization_id": "{{user.impersonating_org_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "organization_id": "{{user.organization_id}}"
        },
        {
          "organization_id": "{{user.impersonating_org_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    }
  }
}
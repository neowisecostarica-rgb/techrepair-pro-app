{
  "name": "Equipo",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n (tenant)"
    },
    "branch_id": {
      "type": "string",
      "description": "Sucursal de alta; acceso legacy tambien se deriva de la OT"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente propietario"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "laptop",
        "desktop",
        "tablet",
        "smartphone",
        "impresora",
        "otro"
      ],
      "description": "Tipo de equipo"
    },
    "marca": {
      "type": "string",
      "description": "Marca del equipo"
    },
    "modelo": {
      "type": "string",
      "description": "Modelo del equipo"
    },
    "serie": {
      "type": "string",
      "description": "N\u00famero de serie o IMEI"
    },
    "estado_fisico": {
      "type": "string",
      "enum": [
        "excelente",
        "bueno",
        "regular",
        "malo"
      ],
      "description": "Estado f\u00edsico al recibir"
    },
    "accesorios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Accesorios incluidos"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de fotos del equipo"
    },
    "reception_correlation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Reception attempt that created the equipment; backend only.",
      "rls": { "read": false, "write": false }
    },
    "created_by_reception": {
      "type": "boolean",
      "default": false,
      "description": "Confirms that the reception orchestrator created the equipment.",
      "rls": { "read": false, "write": false }
    }
  },
  "required": [
    "cliente_id",
    "tipo",
    "marca"
  ],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}

{
  "name": "Garantia",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n (tenant)"
    },
    "branch_id": {
      "type": "string",
      "description": "Sucursal derivada del origen OT o Venta"
    },
    "cliente_id": {
      "type": "string",
      "description": "ID del cliente"
    },
    "origen_tipo": {
      "type": "string",
      "enum": [
        "OT",
        "VENTA"
      ],
      "description": "Tipo de origen (Orden de Trabajo o Venta)"
    },
    "origen_id": {
      "type": "string",
      "description": "ID de la orden de trabajo o venta que genera la garant\u00eda"
    },
    "source": {
      "type": "string",
      "enum": ["WORK_ORDER", "SALE"],
      "description": "Identidad canonica del origen"
    },
    "source_id": {
      "type": "string",
      "description": "ID canonico del work order o sale de origen"
    },
    "source_identity": {
      "type": "string",
      "description": "Clave canonica SOURCE:source_id",
      "rls": { "write": false }
    },
    "equipo_id": {
      "type": "string",
      "description": "Equipo canonico de la OT cuando existe"
    },
    "delivery_operation_key": {
      "type": "string",
      "rls": { "write": false }
    },
    "delivery_request_fingerprint": {
      "type": "string",
      "rls": { "read": false, "write": false }
    },
    "delivery_status": {
      "type": "string",
      "enum": ["PENDING", "COMMITTED"],
      "rls": { "write": false }
    },
    "public_access_token": {
      "type": "string",
      "description": "Token \u00fanico para acceso p\u00fablico sin autenticaci\u00f3n"
    },
    "fecha_emision": {
      "type": "string",
      "format": "date",
      "description": "Fecha de emisi\u00f3n de la garant\u00eda"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio de vigencia de la garant\u00eda"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date",
      "description": "Fecha de fin de vigencia de la garant\u00eda"
    },
    "estado": {
      "type": "string",
      "enum": [
        "PENDIENTE_ACTIVACION",
        "ACTIVA",
        "VENCIDA",
        "ANULADA"
      ],
      "default": "ACTIVA",
      "description": "Estado actual de la garant\u00eda"
    },
    "texto_snapshot": {
      "type": "string",
      "description": "Texto completo e inmutable de la boleta de garant\u00eda"
    },
    "creado_por": {
      "type": "string",
      "description": "ID del usuario que gener\u00f3 la garant\u00eda"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time",
      "rls": { "write": false }
    }
  },
  "required": [
    "organization_id",
    "cliente_id",
    "origen_tipo",
    "origen_id",
    "public_access_token",
    "fecha_emision",
    "fecha_inicio",
    "fecha_fin",
    "estado",
    "texto_snapshot",
    "creado_por"
  ],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}

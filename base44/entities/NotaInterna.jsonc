{
  "name": "NotaInterna",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n (tenant)"
    },
    "orden_trabajo_id": {
      "type": "string",
      "description": "ID de la orden de trabajo"
    },
    "autor_id": {
      "type": "string",
      "description": "ID del usuario que escribe"
    },
    "autor_nombre": {
      "type": "string",
      "description": "Nombre del autor"
    },
    "contenido": {
      "type": "string",
      "description": "Contenido de la nota"
    },
    "menciones": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Roles o usuarios mencionados"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "general",
        "urgente",
        "informativa"
      ],
      "default": "general",
      "description": "Tipo de nota"
    }
  },
  "required": [
    "organization_id",
    "orden_trabajo_id",
    "autor_id",
    "autor_nombre",
    "contenido"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "organization_id": "{{user.organization_id}}"
        },
        {
          "organization_id": "{{user.impersonating_org_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "organization_id": "{{user.organization_id}}"
        },
        {
          "organization_id": "{{user.impersonating_org_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "organization_id": "{{user.organization_id}}"
        },
        {
          "organization_id": "{{user.impersonating_org_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "organization_id": "{{user.organization_id}}"
        },
        {
          "organization_id": "{{user.impersonating_org_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    }
  }
}

{
  "name": "OTEvent",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n (tenant) \u2014 blindaje multitenant, Bloque 0B.2A"
    },
    "orden_trabajo_id": {
      "type": "string",
      "description": "ID de la Orden de Trabajo asociada"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "CREATED",
        "FINALIZADA",
        "ENTREGADA",
        "CANCELADA",
        "SALE_COMPLETED",
        "TRANSITION_ASIGNADA",
        "TRANSITION_REASIGNADA",
        "TRANSITION_EN_REVISION",
        "TRANSITION_DIAGNOSTICADA",
        "TRANSITION_COTIZADA",
        "TRANSITION_APROBADA",
        "TRANSITION_EN_REPARACION",
        "TRANSITION_PRUEBAS",
        "ATTENTION_STATUS_CHANGED",
        "CUSTODIA_CONTACTO",
        "CUSTODIA_ABANDONO",
        "CUSTODIA_DISPOSICION",
        "PRE_DIAGNOSTICO_EDITADO"
      ],
      "description": "Tipo de evento generado"
    },
    "sale_id": {
      "type": "string",
      "description": "ID de la Venta asociada (solo para SALE_COMPLETED)"
    },
    "venta_total": {
      "type": "number",
      "description": "Total de la venta (solo para SALE_COMPLETED)"
    },
    "tipo_concepto": {
      "type": "string",
      "description": "tipo_concepto de la venta (solo para SALE_COMPLETED)"
    },
    "detalle": {
      "type": "string",
      "description": "Detalle adicional del evento. Para TRANSITION_REASIGNADA: JSON con tecnico_anterior_id, tecnico_nuevo_id, usuario_ejecutor, timestamp. Para PRE_DIAGNOSTICO_EDITADO: JSON con campos_modificados, usuario_ejecutor, timestamp."
    },
    "created_by_user_id": {
      "type": "string",
      "description": "ID del usuario que gener\u00f3 el evento"
    },
    "processed": {
      "type": "boolean",
      "default": false,
      "description": "Indica si el evento ya fue procesado por el sistema"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de creaci\u00f3n del evento"
    },
    "reception_correlation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Idempotency identity of the reception that created the event.",
      "rls": { "read": false, "write": false }
    }
  },
  "required": [
    "organization_id",
    "orden_trabajo_id",
    "tipo"
  ],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}

{
  "name": "RegistroTiempo",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n (tenant)"
    },
    "orden_trabajo_id": {
      "type": "string",
      "description": "ID de la orden de trabajo"
    },
    "tecnico_id": {
      "type": "string",
      "description": "ID del t\u00e9cnico"
    },
    "actividad": {
      "type": "string",
      "description": "Descripci\u00f3n de la actividad"
    },
    "inicio": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de inicio"
    },
    "fin": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de fin"
    },
    "duracion_minutos": {
      "type": "number",
      "description": "Duraci\u00f3n en minutos"
    },
    "tipo_actividad": {
      "type": "string",
      "enum": [
        "diagnostico",
        "reparacion",
        "prueba",
        "espera",
        "documentacion"
      ],
      "description": "Tipo de actividad"
    }
  },
  "required": [
    "organization_id",
    "orden_trabajo_id",
    "tecnico_id",
    "actividad",
    "inicio",
    "tipo_actividad"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "organization_id": "{{user.organization_id}}"
        },
        {
          "organization_id": "{{user.impersonating_org_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "organization_id": "{{user.organization_id}}"
        },
        {
          "organization_id": "{{user.impersonating_org_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "organization_id": "{{user.organization_id}}"
        },
        {
          "organization_id": "{{user.impersonating_org_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "organization_id": "{{user.organization_id}}"
        },
        {
          "organization_id": "{{user.impersonating_org_id}}"
        },
        {
          "user_condition": {
            "is_super_admin": true
          }
        }
      ]
    }
  }
}
{
  "name": "SolicitudTecnica",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n (tenant)"
    },
    "branch_id": {
      "type": "string",
      "description": "Sucursal operacional derivada de la membresia canonica"
    },
    "orden_trabajo_id": {
      "type": "string",
      "description": "ID de la orden de trabajo"
    },
    "tecnico_id": {
      "type": "string",
      "description": "ID del t\u00e9cnico que solicita"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "repuesto",
        "suministro",
        "herramienta"
      ],
      "description": "Tipo de solicitud"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripci\u00f3n de lo solicitado"
    },
    "cantidad": {
      "type": "number",
      "default": 1,
      "description": "Cantidad solicitada"
    },
    "estado": {
      "type": "string",
      "enum": [
        "draft",
        "requested",
        "approved",
        "rejected",
        "fulfilled"
      ],
      "default": "draft",
      "description": "Estado de la solicitud"
    },
    "motivo_rechazo": {
      "type": "string",
      "description": "Motivo de rechazo (si aplica)"
    },
    "aprobado_por": {
      "type": "string",
      "description": "ID del usuario que aprob\u00f3"
    },
    "aprobado_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de aprobaci\u00f3n"
    },
    "entregado_por": {
      "type": "string",
      "description": "ID del usuario que entreg\u00f3"
    },
    "entregado_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de entrega"
    },
    "inventario_id": {
      "type": "string",
      "description": "ID del item de inventario (si aplica)"
    },
    "fulfillment_mode": {
      "type": "string",
      "enum": ["EXISTING_STOCK", "NEW_SPEND"],
      "description": "Clasificacion explicita; nunca inferida desde la UI"
    },
    "requester_user_id": { "type": "string", "rls": { "write": false } },
    "requested_at": { "type": "string", "format": "date-time", "rls": { "write": false } },
    "approver_user_id": { "type": "string", "rls": { "write": false } },
    "rejected_by_user_id": { "type": "string", "rls": { "write": false } },
    "rejected_at": { "type": "string", "format": "date-time", "rls": { "write": false } },
    "fulfiller_user_id": { "type": "string", "rls": { "write": false } },
    "fulfilled_at": { "type": "string", "format": "date-time", "rls": { "write": false } },
    "inventory_operation_key": { "type": "string", "rls": { "write": false } },
    "inventory_reservation_id": { "type": "string", "rls": { "write": false } },
    "inventory_movement_id": { "type": "string", "rls": { "write": false } },
    "fulfillment_status": {
      "type": "string",
      "enum": ["PENDING", "COMMITTED"],
      "rls": { "write": false }
    },
    "fulfillment_error": { "type": "string", "rls": { "write": false } },
    "fulfillment_claimed_at": { "type": "string", "format": "date-time", "rls": { "write": false } }
  },
  "required": [
    "organization_id",
    "orden_trabajo_id",
    "tecnico_id",
    "tipo",
    "descripcion",
    "estado"
  ],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}

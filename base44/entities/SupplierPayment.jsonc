{
  "name": "SupplierPayment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n (tenant)"
    },
    "branch_id": {
      "type": "string",
      "description": "Sucursal de la factura de compra relacionada"
    },
    "purchase_invoice_id": {
      "type": "string",
      "description": "ID de la factura de compra (FK PurchaseInvoice)"
    },
    "amount": {
      "type": "number",
      "description": "Monto del pago/abono"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del pago"
    },
    "method": {
      "type": "string",
      "enum": [
        "efectivo",
        "transferencia",
        "cheque",
        "tarjeta"
      ],
      "description": "M\u00e9todo de pago"
    },
    "reference": {
      "type": "string",
      "description": "N\u00famero de referencia (transferencia/cheque)"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales"
    },
    "created_by": {
      "type": "string",
      "description": "Usuario que registr\u00f3 el pago"
    }
  },
  "required": [
    "organization_id",
    "purchase_invoice_id",
    "amount",
    "date",
    "method",
    "created_by"
  ],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}

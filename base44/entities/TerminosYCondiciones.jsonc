{
  "name": "TerminosYCondiciones",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n (tenant)"
    },
    "version": {
      "type": "string",
      "description": "Versi\u00f3n de los t\u00e9rminos (ej: v1.0, v1.1)"
    },
    "texto": {
      "type": "string",
      "description": "Texto completo de los t\u00e9rminos y condiciones"
    },
    "activo": {
      "type": "boolean",
      "default": true,
      "description": "Si esta versi\u00f3n est\u00e1 activa (solo una por org)"
    }
  },
  "required": [
    "organization_id",
    "version",
    "texto"
  ],
  "rls": { "create": false, "read": false, "update": false, "delete": false }
}

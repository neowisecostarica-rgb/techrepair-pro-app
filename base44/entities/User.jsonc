{
  "name": "User",
  "type": "object",
  "properties": {
    "is_super_admin": {
      "type": "boolean",
      "default": false,
      "description": "Compatibilidad visual. La autoridad canonica es el role built-in admin.",
      "rls": { "read": true, "write": false }
    },
    "organization_id": {
      "type": "string",
      "description": "Tenant activo persistido exclusivamente por identityGateway",
      "rls": { "read": true, "write": false }
    },
    "impersonating_org_id": {
      "type": "string",
      "description": "Tenant impersonado persistido exclusivamente por identityGateway",
      "rls": { "read": true, "write": false }
    },
    "impersonating_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Inicio de impersonacion controlado por backend",
      "rls": { "read": true, "write": false }
    },
    "impersonation_previous_organization_id": {
      "type": "string",
      "description": "Tenant previo para restaurar al finalizar impersonacion",
      "rls": { "read": false, "write": false }
    }
  },
  "required": []
}
